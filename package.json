{
  "name": "ebike-rental-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" package*.json *.config.js *.config.ts *.json *.html README.md .github/workflows/*.yml .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" package*.json *.config.js *.config.ts *.json *.html README.md .github/workflows/*.yml .prettierrc.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:safari": "node tests/safari/safari-smoke.mjs",
    "diagrams:generate": "node scripts/generate-diagrams.mjs",
    "diagrams:check": "node scripts/generate-diagrams.mjs --check"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "selenium-webdriver": "4.51.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.2",
    "vite": "7.1.4",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
